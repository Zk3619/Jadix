# Temporary and generated files
tmp_*
tmp_*/
tmp_svgs/
crates/rui/tmp_stack_crumb.txt
*.tmp
*.cache
*.log

# Editors
*.swp
*.swo
# Ignore everything by default
*

# Keep this file manageable in Git
!.gitignore

!README.md

# Allow root Rust manifest/lock files
!Cargo.toml
!Cargo.lock

# Allow the two main source directories and all contents
!crates/
!crates/**

!examples/
!examples/**

!docs/
!docs/**

# CI definitions (ignored by the blanket `*` above without this)
!.github/
!.github/**