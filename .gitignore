# Temporary and generated files
tmp_*
tmp_*/
tmp_svgs/
crates/jadix/tmp_stack_crumb.txt
*.tmp
*.cache
*.log

# Editors
*.swp
*.swo
# Ignore everything by default
*

# Keep this file manageable in Git
!.gitignore

!README.md
!CONTEXT.md
!LICENSE
!NOTICE

# Allow root Rust manifest/lock files
!Cargo.toml
!Cargo.lock

# Local upstream glyphon patch: batched, on-demand glyph atlas uploads.
!vendor/
vendor/*
!vendor/glyphon/
!vendor/glyphon/**
!vendor/taffy/
!vendor/taffy/**
vendor/taffy/target/
!vendor/naga/
!vendor/naga/**
vendor/naga/target/
!vendor/wgpu-core/
!vendor/wgpu-core/**
vendor/wgpu-core/target/
!vendor/wgpu-types/
!vendor/wgpu-types/**
vendor/wgpu-types/target/
!vendor/wgpu-hal/
!vendor/wgpu-hal/**
vendor/wgpu-hal/target/
!vendor/gpui-pre-windows-0.3.9/
!vendor/gpui-pre-windows-0.3.9/**
!vendor/gpui-fast-windows-0.1.9/
!vendor/gpui-fast-windows-0.1.9/**
# Small native API extensions, pinned to jadix_winit's upstream core revision.
!vendor/winit-wayland/
!vendor/winit-wayland/**
!vendor/winit-win32/
!vendor/winit-win32/**
vendor/winit-wayland/target/
vendor/winit-win32/target/

# Allow the two main source directories and all contents
!crates/
!crates/**

!examples/
!examples/**

# Published docs placeholder (content lives in development-docs/, ignored).
!docs/
docs/*
!docs/.gitkeep
!docs/async-architecture.md
development-docs/

!scripts/
!scripts/**

!deny.toml

# CI definitions (ignored by the blanket `*` above without this)
!.github/
!.github/**

# Re-exclude temps that `!crates/**` / `!examples/**` would otherwise track.
**/.tmp/
**/*.log
**/*.tmp
**/*.cache
**/tmp/
**/tmp_*/
**/*.diff

# Public application icon configuration and integration guide.
!docs/application-icons.md
!docs/app-icons.example.toml
!docs/desktop-windows.md
!docs/devtools.md
scripts/__pycache__/

!assets/
assets/*
!assets/logo.png
!assets/app-icons.toml
!assets/icons/
!assets/icons/**
