# Temporary and generated files
tmp_*
tmp_*/
tmp_svgs/
crates/jadix/tmp_stack_crumb.txt
*.tmp
*.cache
*.log

# Editors
*.swp
*.swo
# Ignore everything by default
*

# Keep this file manageable in Git
!.gitignore
!.gitattributes

!README.md
!README.zh.md
!LICENSE
!NOTICE

# Allow root Rust manifest/lock files
!Cargo.toml
!Cargo.toml.bak
!Cargo.lock

# Maintained vendored libraries and benchmark dependencies.
!vendor/
vendor/*
!vendor/gpui-pre-windows-0.3.9/
!vendor/gpui-pre-windows-0.3.9/**
vendor/gpui-pre-windows-0.3.9/target/
!vendor/gpui-fast-windows-0.1.9/
!vendor/gpui-fast-windows-0.1.9/**
vendor/gpui-fast-windows-0.1.9/target/
!vendor/RELEASE_FORKS.json

# Allow the two main source directories and all contents
!crates/
!crates/**
crates/**/target/

!examples/
!examples/**

# Published docs placeholder (content lives in development-docs/, ignored).
!docs/
docs/*
!docs/.gitkeep
!docs/async-architecture.md
!docs/state-management.md
!docs/remote-assets.md
development-docs/

!scripts/
!scripts/**

!deny.toml

# CI definitions (ignored by the blanket `*` above without this)
!.github/
!.github/**

# Re-exclude temps that `!crates/**` / `!examples/**` would otherwise track.
**/.tmp/
**/*.log
**/*.tmp
**/*.cache
**/tmp/
**/tmp_*/
**/*.diff

# Public application icon configuration and integration guide.
!docs/application-icons.md
!docs/app-icons.example.toml
!docs/desktop-windows.md
!docs/devtools.md
!docs/FEATURES.md
!docs/README.md
!docs/*.md
!docs/component-authoring.md
scripts/**/__pycache__/
scripts/**/target/

!assets/
assets/*
!assets/logo.png
!assets/app-icons.toml
!assets/icons/
!assets/icons/**
!docs/css-properties-checklist.md
