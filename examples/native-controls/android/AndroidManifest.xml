<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="dev.jadix.nativeui">
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="35" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <queries><intent><action android:name="android.speech.RecognitionService" /></intent></queries>
    <instrumentation android:name=".NativeChecks" android:targetPackage="dev.jadix.nativeui" android:label="Jadix native checks" />
    <instrumentation android:name=".NativeKeyboardChecks" android:targetPackage="dev.jadix.nativeui" android:label="Jadix native keyboard checks" />
    <instrumentation android:name=".NativeEditingChecks" android:targetPackage="dev.jadix.nativeui" android:label="Jadix native editing checks" />
    <instrumentation android:name=".NativeCapabilityChecks" android:targetPackage="dev.jadix.nativeui" android:label="Jadix native capability checks" />
    <instrumentation android:name=".NativeShellChecks" android:targetPackage="dev.jadix.nativeui" android:label="Jadix native Shell checks" />
    <application android:enableOnBackInvokedCallback="true" android:label="Jadix Native" android:theme="@android:style/Theme.Material.Light.NoActionBar" android:debuggable="true" android:extractNativeLibs="true" android:allowBackup="false">
        <provider android:name="dev.jadix.nativeui.NativeShareProvider" android:authorities="dev.jadix.nativeui.jadix.share" android:exported="false" android:grantUriPermissions="true" />
        <receiver android:name="dev.jadix.nativeui.NativeShare$ChosenReceiver" android:exported="false" />
        <activity android:name=".MainActivity" android:exported="true" android:windowSoftInputMode="adjustResize" android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="jadix-check" />
            </intent-filter>
        </activity>
    </application>
</manifest>
