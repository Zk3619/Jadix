<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="dev.jadix.nativeui">
    <uses-sdk android:minSdkVersion="28" android:targetSdkVersion="35" />
    <instrumentation android:name=".NativeChecks" android:targetPackage="dev.jadix.nativeui" android:label="Jadix native checks" />
    <instrumentation android:name=".NativeKeyboardChecks" android:targetPackage="dev.jadix.nativeui" android:label="Jadix native keyboard checks" />
    <instrumentation android:name=".NativeEditingChecks" android:targetPackage="dev.jadix.nativeui" android:label="Jadix native editing checks" />
    <application android:label="Jadix Native" android:theme="@android:style/Theme.Material.Light.NoActionBar" android:debuggable="true" android:extractNativeLibs="true" android:allowBackup="false">
        <activity android:name=".MainActivity" android:exported="true" android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
