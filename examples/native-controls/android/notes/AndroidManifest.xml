<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="dev.jadix.notebook">
    <uses-sdk android:minSdkVersion="28" android:targetSdkVersion="35" />
    <instrumentation android:name="dev.jadix.nativeui.NotesChecks" android:targetPackage="dev.jadix.notebook" android:label="Jadix Notes checks" />
    <instrumentation android:name="dev.jadix.nativeui.NotesScaleChecks" android:targetPackage="dev.jadix.notebook" android:label="Jadix Notes capacity checks" />
    <application android:label="Jadix Notes" android:theme="@android:style/Theme.Material.Light.NoActionBar" android:debuggable="true" android:extractNativeLibs="true" android:allowBackup="false">
        <activity android:name="dev.jadix.nativeui.NotesActivity" android:exported="true" android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
