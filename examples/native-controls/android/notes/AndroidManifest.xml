<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="dev.jadix.notebook">
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="35" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <queries><intent><action android:name="android.speech.RecognitionService" /></intent></queries>
    <instrumentation android:name="dev.jadix.nativeui.NotesChecks" android:targetPackage="dev.jadix.notebook" android:label="Jadix Notes checks" />
    <instrumentation android:name="dev.jadix.nativeui.NotesScaleChecks" android:targetPackage="dev.jadix.notebook" android:label="Jadix Notes capacity checks" />
    <application android:enableOnBackInvokedCallback="true" android:label="Jadix Notes" android:theme="@android:style/Theme.Material.Light.NoActionBar" android:debuggable="true" android:extractNativeLibs="true" android:allowBackup="false">
        <provider android:name="dev.jadix.nativeui.NativeShareProvider" android:authorities="dev.jadix.notebook.jadix.share" android:exported="false" android:grantUriPermissions="true" />
        <receiver android:name="dev.jadix.nativeui.NativeShare$ChosenReceiver" android:exported="false" />
        <activity android:name="dev.jadix.nativeui.NotesActivity" android:exported="true" android:windowSoftInputMode="adjustResize" android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
