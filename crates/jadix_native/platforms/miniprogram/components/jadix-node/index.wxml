<block wx:if="{{node}}">
  <block wx:if="{{node.kind === 'dialog' || node.kind === 'popover'}}">
    <view wx:if="{{node.open}}" class="overlay" style="z-index:{{1000 + node.overlay}};background:{{node.kind === 'dialog' ? 'rgba(0,0,0,0.32)' : 'transparent'}};" catchtap="onDismiss">
      <view id="{{node.accessibilityId}}" class="{{node.focusWithin ? 'focus-within' : ''}}" style="{{node.css}}" catchtap="onPanelTap" aria-role="{{node.kind === 'dialog' ? 'dialog' : ''}}" aria-label="{{node.accessibilityLabel}}" aria-activedescendant="{{node.accessibilityActiveDescendant}}" aria-controls="{{node.accessibilityControlsAttribute}}">
        <jadix-node wx:for="{{node.children}}" wx:key="id" node="{{item}}" />
      </view>
    </view>
  </block>
  <view wx:elif="{{node.kind === 'box'}}" id="{{node.accessibilityId}}" class="{{node.focusWithin ? 'focus-within' : ''}}" style="{{node.css}}" aria-label="{{node.accessibilityLabel}}" aria-activedescendant="{{node.accessibilityActiveDescendant}}" aria-controls="{{node.accessibilityControlsAttribute}}">
    <jadix-node wx:for="{{node.children}}" wx:key="id" node="{{item}}" />
  </view>
  <scroll-view wx:elif="{{node.kind === 'scroll'}}" id="{{node.accessibilityId}}" class="{{node.focusWithin ? 'focus-within' : ''}}" style="{{node.css}}" scroll-x="{{node.style.scrollbars[0]}}" scroll-y="{{node.style.scrollbars[1]}}" scroll-left="{{node.scrollX}}" scroll-top="{{node.scrollY}}" bindscroll="onScroll" aria-label="{{node.accessibilityLabel}}" aria-activedescendant="{{node.accessibilityActiveDescendant}}" aria-controls="{{node.accessibilityControlsAttribute}}">
    <view style="position:relative;width:{{node.contentWidth}}px;height:{{node.contentHeight}}px;">
      <jadix-node wx:for="{{node.children}}" wx:key="id" node="{{item}}" />
    </view>
  </scroll-view>
  <text wx:elif="{{node.kind === 'text'}}" id="{{node.accessibilityId}}" style="{{node.css}}" class="text {{node.style.text_overflow || 'wrap'}}" aria-label="{{node.accessibilityLabel}}" aria-activedescendant="{{node.accessibilityActiveDescendant}}" aria-controls="{{node.accessibilityControlsAttribute}}"><text wx:for="{{node.spans}}" wx:key="index" style="{{item.css}}">{{item.text}}</text></text>
  <radio-group wx:elif="{{node.kind === 'button' && node.role === 'radio'}}" id="{{node.accessibilityId}}" style="{{node.css}}" bindchange="onRadio" aria-activedescendant="{{node.accessibilityActiveDescendant}}" aria-controls="{{node.accessibilityControlsAttribute}}"><label><radio value="selected" checked="{{node.selected}}" disabled="{{!node.enabled}}" aria-label="{{node.accessibilityLabel}}" />{{node.text}}</label></radio-group>
  <button wx:elif="{{node.kind === 'button'}}" id="{{node.accessibilityId}}" class="{{node.focusVisible ? 'focus-visible' : ''}}" style="{{node.css}}" disabled="{{!node.enabled}}" catchtap="onTap" aria-label="{{node.accessibilityLabel}}" aria-activedescendant="{{node.accessibilityActiveDescendant}}" aria-controls="{{node.accessibilityControlsAttribute}}">{{node.text}}</button>
  <input wx:elif="{{node.kind === 'input'}}" id="{{node.accessibilityId}}" class="{{node.focusVisible ? 'focus-visible' : ''}}" style="{{node.css}}" value="{{node.text}}" placeholder="{{node.placeholder}}" password="{{node.password}}" disabled="{{!node.enabled}}" focus="{{node.focused}}" maxlength="{{node.maxLength === null ? -1 : node.maxLength}}" selection-start="{{node.selectionStart}}" selection-end="{{node.selectionEnd}}" bindinput="onInput" bindconfirm="onConfirm" bindfocus="onFocus" bindblur="onBlur" aria-label="{{node.accessibilityLabel}}" aria-activedescendant="{{node.accessibilityActiveDescendant}}" aria-controls="{{node.accessibilityControlsAttribute}}" />
  <textarea wx:elif="{{node.kind === 'textarea'}}" id="{{node.accessibilityId}}" class="{{node.focusVisible ? 'focus-visible' : ''}}" style="{{node.css}}" value="{{node.text}}" placeholder="{{node.placeholder}}" disabled="{{!node.enabled}}" focus="{{node.focused}}" maxlength="{{node.maxLength === null ? -1 : node.maxLength}}" selection-start="{{node.selectionStart}}" selection-end="{{node.selectionEnd}}" bindinput="onInput" bindconfirm="onConfirm" bindfocus="onFocus" bindblur="onBlur" aria-label="{{node.accessibilityLabel}}" aria-activedescendant="{{node.accessibilityActiveDescendant}}" aria-controls="{{node.accessibilityControlsAttribute}}" />
  <checkbox-group wx:elif="{{node.kind === 'checkbox'}}" id="{{node.accessibilityId}}" style="{{node.css}}" bindchange="onToggle" aria-activedescendant="{{node.accessibilityActiveDescendant}}" aria-controls="{{node.accessibilityControlsAttribute}}"><label><checkbox value="checked" checked="{{node.checked}}" disabled="{{!node.enabled}}" aria-label="{{node.accessibilityLabel}}" />{{node.text}}</label></checkbox-group>
  <view wx:elif="{{node.kind === 'switch'}}" id="{{node.accessibilityId}}" style="{{node.css}}" aria-activedescendant="{{node.accessibilityActiveDescendant}}" aria-controls="{{node.accessibilityControlsAttribute}}"><switch checked="{{node.checked}}" disabled="{{!node.enabled}}" bindchange="onToggle" aria-label="{{node.accessibilityLabel}}" />{{node.text}}</view>
  <picker wx:elif="{{node.kind === 'select'}}" id="{{node.accessibilityId}}" style="{{node.css}}" mode="selector" range="{{node.optionLabels}}" value="{{node.selectedIndex}}" disabled="{{!node.selectEnabled}}" bindchange="onSelect" aria-label="{{node.accessibilityLabel}}" aria-activedescendant="{{node.accessibilityActiveDescendant}}" aria-controls="{{node.accessibilityControlsAttribute}}"><view>{{node.selectedLabel}}</view></picker>
  <image wx:elif="{{node.kind === 'image'}}" id="{{node.accessibilityId}}" style="{{node.css}}" src="{{node.source}}" mode="aspectFit" aria-label="{{node.accessibilityLabel}}" aria-activedescendant="{{node.accessibilityActiveDescendant}}" aria-controls="{{node.accessibilityControlsAttribute}}" />
</block>
